@{
    ViewData["Title"] = "Thanh toán thành công – VTWiki";
}

<section class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center py-16 overflow-hidden bg-background-light dark:bg-background-dark">

    <!-- Ambient blobs -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-primary/10 blur-[120px]"></div>
        <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full bg-primary/5 blur-[80px]"></div>
    </div>

    <div class="relative z-10 w-full max-w-lg mx-auto px-4">

        <!-- Card -->
        <div class="bg-surface-light dark:bg-surface-dark rounded-2xl shadow-2xl shadow-primary/10 border border-primary/10 overflow-hidden">

            <!-- Top accent strip -->
            <div class="h-1.5 w-full bg-gradient-to-r from-primary via-purple-400 to-primary-dark"></div>

            <div class="p-10 text-center">

                <!-- Icon badge -->
                <div class="mx-auto mb-6 w-20 h-20 rounded-full flex items-center justify-center ring-8 ring-green-500/10"
                     style="background: linear-gradient(135deg,#22c55e22,#16a34a11)">
                    <span class="material-symbols-outlined text-green-500 text-5xl" style="font-variation-settings:'FILL' 1">check_circle</span>
                </div>

                <!-- Heading -->
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white mb-2">
                    Quyên góp thành công! 🎉
                </h1>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
                    Cảm ơn bạn đã ủng hộ <span class="font-bold text-primary">VTWiki</span>.<br>
                    Mỗi đóng góp đều giúp cộng đồng chúng ta lớn mạnh hơn.
                </p>

                <!-- Info box -->
                <div class="mb-8 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 p-4 flex items-start gap-3 text-left">
                    <span class="material-symbols-outlined text-green-500 mt-0.5 flex-shrink-0" style="font-variation-settings:'FILL' 1">volunteer_activism</span>
                    <p class="text-sm text-green-700 dark:text-green-300 font-medium">
                        Giao dịch của bạn đã được xác nhận thành công qua VNPay Sandbox. Cảm ơn rất nhiều!
                    </p>
                </div>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <a asp-controller="Home" asp-action="Index"
                       class="flex-1 flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-sm transition-all shadow-lg shadow-primary/25 hover:-translate-y-0.5">
                        <span class="material-symbols-outlined text-[18px]">home</span>
                        Trang chủ
                    </a>
                    <a asp-controller="Home" asp-action="Donate"
                       class="flex-1 flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-primary hover:text-primary dark:hover:border-primary dark:hover:text-primary font-bold text-sm transition-all">
                        <span class="material-symbols-outlined text-[18px]">volunteer_activism</span>
                        Donate lại
                    </a>
                </div>
            </div>
        </div>

        {{!-- Back link --}}
        <div class="text-center mt-6">
            <a asp-controller="Forum" asp-action="CommunityHub"
               class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-[16px]">groups</span>
                Khám phá cộng đồng
            </a>
        </div>

    </div>
</section>
