@{
    ViewData["Title"] = "Ủng hộ WikiForum qua VNPay";
}

<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden bg-slate-50 dark:bg-slate-900">
    <main class="flex-1 py-16 md:py-24">
        <div class="max-w-3xl mx-auto px-4 md:px-10">
            <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-xl shadow-primary/10 overflow-hidden border border-primary/10">
                <div class="bg-primary p-8 text-center text-white relative overflow-hidden">
                    <!-- Background pattern -->
                    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
                    <div class="relative z-10">
                        <span class="material-symbols-outlined text-5xl mb-4">volunteer_activism</span>
                        <h1 class="text-3xl font-black mb-2">Quyên góp qua VNPay</h1>
                        <p class="text-white/80">Mọi sự đóng góp của bạn đều giúp duy trì và phát triển cộng đồng WikiForum lớn mạnh hơn!</p>
                    </div>
                </div>

                <div class="p-8 md:p-12">
                    @if (TempData["Error"] != null)
                    {
                        <div class="bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 p-4 rounded-xl mb-6 flex items-start gap-3 border border-red-200 dark:border-red-800">
                            <span class="material-symbols-outlined mt-0.5">error</span>
                            <p class="font-medium text-sm">@TempData["Error"]</p>
                        </div>
                    }

                    <form asp-action="CreatePayment" asp-controller="Donation" method="post" class="space-y-6">
                        <!-- Số tiền -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Số tiền quyên góp (VND)</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold">₫</span>
                                <input type="number" name="amount" min="10000" step="1000" value="50000" required
                                       class="w-full bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-xl py-3 pl-10 pr-4 focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white font-bold text-lg outline-none" />
                            </div>
                            <p class="text-xs text-slate-500 mt-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">info</span> Tối thiểu 10,000 VND
                            </p>
                            
                            <!-- Quick amount selection -->
                            <div class="grid grid-cols-3 gap-3 mt-4">
                                <button type="button" onclick="document.querySelector('input[name=amount]').value=50000" class="py-2 px-4 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:bg-primary/5 hover:text-primary dark:hover:border-primary dark:hover:text-primary transition-colors font-bold text-sm">50,000</button>
                                <button type="button" onclick="document.querySelector('input[name=amount]').value=100000" class="py-2 px-4 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:bg-primary/5 hover:text-primary dark:hover:border-primary dark:hover:text-primary transition-colors font-bold text-sm">100,000</button>
                                <button type="button" onclick="document.querySelector('input[name=amount]').value=500000" class="py-2 px-4 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-primary hover:bg-primary/5 hover:text-primary dark:hover:border-primary dark:hover:text-primary transition-colors font-bold text-sm">500,000</button>
                            </div>
                        </div>

                        <!-- Lời nhắn -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Lời nhắn (Không bắt buộc)</label>
                            <textarea name="message" rows="4" placeholder="Chia sẻ cảm nghĩ của bạn với chúng tôi..."
                                      class="w-full bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-xl p-4 focus:ring-2 focus:ring-primary focus:border-primary transition-all text-slate-900 dark:text-white text-sm outline-none"></textarea>
                        </div>

                        <div class="pt-4">
                            <button type="submit" class="w-full flex items-center justify-center gap-3 bg-[#005BAA] hover:bg-[#004A8B] text-white font-bold text-lg py-4 px-8 rounded-xl shadow-lg shadow-[#005BAA]/30 transition-all transform hover:-translate-y-1">
                                Thanh toán qua VNPay
                            </button>
                            <p class="text-center text-xs text-slate-500 mt-4 flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-[14px] text-green-500">lock</span> Thanh toán an toàn, bảo mật thông qua hệ thống VNPay Sandbox
                            </p>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-8">
                <a asp-controller="Home" asp-action="Donate" class="inline-flex items-center gap-2 text-slate-500 hover:text-primary transition-colors text-sm font-bold">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Quay lại trang Donate
                </a>
            </div>
        </div>
    </main>
</div>
