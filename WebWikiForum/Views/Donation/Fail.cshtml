@{
    ViewData["Title"] = "Thanh toán thất bại – VTWiki";
}

<section class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center py-16 overflow-hidden bg-background-light dark:bg-background-dark">

    <!-- Ambient blobs -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-red-500/8 blur-[120px]"></div>
        <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full bg-primary/5 blur-[80px]"></div>
    </div>

    <div class="relative z-10 w-full max-w-lg mx-auto px-4">

        <!-- Card -->
        <div class="bg-surface-light dark:bg-surface-dark rounded-2xl shadow-2xl shadow-red-500/10 border border-red-500/15 overflow-hidden">

            <!-- Top accent strip -->
            <div class="h-1.5 w-full bg-gradient-to-r from-red-500 via-rose-400 to-red-600"></div>

            <div class="p-10 text-center">

                <!-- Icon badge -->
                <div class="mx-auto mb-6 w-20 h-20 rounded-full flex items-center justify-center ring-8 ring-red-500/10"
                     style="background: linear-gradient(135deg,#ef444422,#dc262611)">
                    <span class="material-symbols-outlined text-red-500 text-5xl" style="font-variation-settings:'FILL' 1">cancel</span>
                </div>

                <!-- Heading -->
                <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white mb-2">
                    Thanh toán thất bại
                </h1>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
                    Rất tiếc! Giao dịch của bạn chưa được hoàn tất.<br>
                    Bạn có thể thử lại hoặc liên hệ hỗ trợ nếu cần.
                </p>

                <!-- Error message box -->
                @if (TempData["Message"] != null)
                {
                    <div class="mb-8 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4 flex items-start gap-3 text-left">
                        <span class="material-symbols-outlined text-red-500 mt-0.5 flex-shrink-0" style="font-variation-settings:'FILL' 1">error</span>
                        <p class="text-sm text-red-700 dark:text-red-300 font-medium">@TempData["Message"]</p>
                    </div>
                }
                else
                {
                    <div class="mb-8 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4 flex items-start gap-3 text-left">
                        <span class="material-symbols-outlined text-red-500 mt-0.5 flex-shrink-0" style="font-variation-settings:'FILL' 1">info</span>
                        <p class="text-sm text-red-700 dark:text-red-300 font-medium">
                            Giao dịch đã bị hủy hoặc xảy ra lỗi trong quá trình xử lý thanh toán qua VNPay.
                        </p>
                    </div>
                }

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <a asp-controller="Donation" asp-action="Index"
                       class="flex-1 flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-sm transition-all shadow-lg shadow-primary/25 hover:-translate-y-0.5">
                        <span class="material-symbols-outlined text-[18px]">refresh</span>
                        Thử lại
                    </a>
                    <a asp-controller="Home" asp-action="Index"
                       class="flex-1 flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-primary hover:text-primary dark:hover:border-primary dark:hover:text-primary font-bold text-sm transition-all">
                        <span class="material-symbols-outlined text-[18px]">home</span>
                        Trang chủ
                    </a>
                </div>
            </div>
        </div>

        <!-- Back link -->
        <div class="text-center mt-6">
            <a asp-controller="Home" asp-action="Donate"
               class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-[16px]">volunteer_activism</span>
                Xem các mức đóng góp
            </a>
        </div>

    </div>
</section>
